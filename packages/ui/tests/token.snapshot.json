{
  "meta": {
    "product": "Liiiraa Booster",
    "signature": "Signed by Liiiraa",
    "theme": "dark command center",
    "version": "0.1.0"
  },
  "colors": {
    "background": {
      "app": "#0b0f14",
      "appSubtle": "#10161d",
      "workspace": "#111820",
      "overlay": "rgba(5, 8, 12, 0.78)"
    },
    "surface": {
      "panel": "#151d26",
      "panelAlt": "#1a2430",
      "raised": "#202b37",
      "sunken": "#0f151c",
      "selected": "#173446",
      "disabled": "#222a33",
      "premium": "#18212c",
      "lane": "#121a23",
      "proof": "#162431",
      "glass": "rgba(21, 29, 38, 0.9)"
    },
    "border": {
      "subtle": "#2a3541",
      "default": "#344252",
      "strong": "#4b5c70",
      "focus": "#27d7ff"
    },
    "text": {
      "primary": "#f5f8fb",
      "secondary": "#b6c2cf",
      "muted": "#7d8a99",
      "inverse": "#071015",
      "disabled": "#5f6b78"
    },
    "accent": {
      "telemetry": "#27d7ff",
      "telemetrySoft": "#124a5c",
      "performance": "#3af28f",
      "performanceSoft": "#0f5c38",
      "violet": "#9b7cff",
      "violetSoft": "#2b2454"
    },
    "status": {
      "success": "#3af28f",
      "successSurface": "#0f3b29",
      "active": "#27d7ff",
      "activeSurface": "#103a49",
      "warning": "#ffbd5a",
      "warningSurface": "#4b3214",
      "danger": "#ff5a67",
      "dangerSurface": "#4a1f28",
      "trust": "#42e6b4",
      "trustSurface": "#113d34",
      "rollback": "#d7b86a",
      "rollbackSurface": "#45381a",
      "benchmark": "#62c7d8",
      "benchmarkSurface": "#123943",
      "locked": "#8b97a6",
      "lockedSurface": "#222a33",
      "neutral": "#9aa8b8",
      "neutralSurface": "#26313d"
    },
    "risk": {
      "low": "#3af28f",
      "medium": "#27d7ff",
      "high": "#ffbd5a",
      "critical": "#ff5a67",
      "lab": "#9b7cff"
    },
    "mode": {
      "safe": "#3af28f",
      "competitive": "#ffbd5a",
      "lab": "#9b7cff",
      "blocked": "#ff5a67"
    },
    "chart": {
      "fpsAverage": "#27d7ff",
      "fpsLow": "#3af28f",
      "frametime": "#ffbd5a",
      "dropped": "#ff5a67",
      "cpu": "#9b7cff",
      "gpu": "#42e6b4",
      "grid": "#26313d"
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "Inter, Geist, Segoe UI, system-ui, sans-serif",
      "metric": "JetBrains Mono, Geist Mono, Consolas, monospace"
    },
    "fontSize": {
      "caption": "0.75rem",
      "control": "0.8125rem",
      "body": "0.875rem",
      "label": "0.875rem",
      "title": "1rem",
      "section": "1.25rem",
      "display": "2rem"
    },
    "lineHeight": {
      "tight": "1.15",
      "control": "1.25",
      "body": "1.45",
      "display": "1.1"
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "letterSpacing": {
      "default": "0",
      "caps": "0.08em"
    }
  },
  "radius": {
    "none": "0",
    "xs": "0.125rem",
    "sm": "0.25rem",
    "md": "0.375rem",
    "card": "0.5rem",
    "pill": "999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "emphasis": "2px"
  },
  "shadow": {
    "panel": "0 16px 48px rgba(0, 0, 0, 0.32)",
    "raised": "0 12px 28px rgba(0, 0, 0, 0.28)",
    "premium": "0 22px 64px rgba(0, 0, 0, 0.38)",
    "focus": "0 0 0 3px rgba(39, 215, 255, 0.28)",
    "danger": "0 0 0 3px rgba(255, 90, 103, 0.2)",
    "insetHairline": "inset 0 0 0 1px rgba(255, 255, 255, 0.025)",
    "stateRing": "0 0 0 1px rgba(39, 215, 255, 0.2)"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "normal": "220ms",
      "slow": "360ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "components": {
    "rail": {
      "width": "4.5rem",
      "expandedWidth": "15rem"
    },
    "statusStrip": {
      "height": "2.75rem"
    },
    "toolbar": {
      "height": "2.5rem",
      "iconButton": "2rem"
    },
    "button": {
      "height": {
        "sm": "2rem",
        "md": "2.45rem",
        "lg": "2.75rem"
      },
      "paddingX": {
        "sm": "0.625rem",
        "md": "0.9rem",
        "lg": "1.1rem"
      },
      "gap": "0.5rem",
      "minWidth": "7.25rem",
      "iconSize": "1rem",
      "borderRadius": "0.5rem"
    },
    "buttonVariant": {
      "primary": {
        "surface": "status.active",
        "text": "text.inverse",
        "border": "status.active"
      },
      "secondary": {
        "surface": "surface.raised",
        "text": "text.primary",
        "border": "border.default"
      },
      "ghost": {
        "surface": "transparent",
        "text": "text.secondary",
        "border": "transparent"
      },
      "destructive": {
        "surface": "status.dangerSurface",
        "text": "status.danger",
        "border": "status.danger"
      },
      "rollback": {
        "surface": "status.rollbackSurface",
        "text": "status.rollback",
        "border": "status.rollback"
      },
      "locked": {
        "surface": "status.lockedSurface",
        "text": "text.disabled",
        "border": "border.subtle"
      },
      "success": {
        "surface": "status.successSurface",
        "text": "status.success",
        "border": "status.success"
      }
    },
    "iconButton": {
      "size": {
        "sm": "2rem",
        "md": "2.25rem",
        "lg": "2.5rem"
      },
      "borderRadius": "0.375rem"
    },
    "segmentedControl": {
      "minHeight": "2.45rem",
      "padding": "0.25rem",
      "gap": "0.25rem",
      "borderRadius": "0.5rem"
    },
    "tab": {
      "height": "2.4rem",
      "paddingX": "0.75rem",
      "borderRadius": "0.375rem"
    },
    "toggle": {
      "width": "2.75rem",
      "height": "1.5rem",
      "thumb": "1.05rem"
    },
    "metricTile": {
      "minHeight": "6rem"
    },
    "card": {
      "padding": "1rem",
      "gap": "0.75rem",
      "borderRadius": "0.5rem"
    },
    "categoryLane": {
      "minHeight": "7.5rem",
      "accentWidth": "0.1875rem",
      "gap": "0.75rem",
      "summaryMinWidth": "12rem"
    },
    "proofTile": {
      "minHeight": "6.5rem",
      "metricMinWidth": "6rem",
      "accentHeight": "0.1875rem"
    },
    "trustBadge": {
      "minHeight": "2.5rem",
      "minWidth": "9rem",
      "gap": "0.5rem"
    },
    "stateBadge": {
      "minHeight": "1.55rem",
      "paddingX": "0.5rem",
      "gap": "0.375rem"
    },
    "benchmarkDelta": {
      "minHeight": "3rem",
      "trackHeight": "0.72rem",
      "valueMinWidth": "5rem"
    },
    "drawer": {
      "width": "24rem",
      "maxWidth": "min(24rem, 92vw)",
      "scrim": "rgba(5, 8, 12, 0.78)"
    },
    "actionBar": {
      "height": "4.25rem"
    },
    "focusRing": {
      "width": "2px",
      "offset": "2px"
    }
  }
}
