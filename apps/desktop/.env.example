# Liiiraa Booster desktop environment template.
# Only public, non-secret values may be exposed to the desktop app. The desktop
# app must call the API and must never receive Neon credentials or signing keys.

VITE_PUBLIC_APP_NAME=Liiiraa Booster
VITE_PUBLIC_API_BASE_URL=http://localhost:4010
VITE_PUBLIC_RELEASE_CHANNEL=dev
VITE_PUBLIC_TELEMETRY_DEFAULT=off
VITE_PUBLIC_CRASH_REPORTS_DEFAULT=off
TAURI_DEV_HOST=http://localhost:1420
