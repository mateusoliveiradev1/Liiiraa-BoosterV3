# Liiiraa Booster API environment template.
# Server-only values belong here. Keep real credentials in ignored local files
# or protected CI secrets, never in committed examples.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4010
API_PUBLIC_BASE_URL=http://localhost:4010
API_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173
TRPC_ENDPOINT=/trpc

# Neon Postgres. Runtime must use the pooled URL; migrations may use the direct
# URL when Neon or Drizzle requires it.
NEON_DATABASE_URL=
NEON_DATABASE_DIRECT_URL=
DRIZZLE_MIGRATIONS_DIR=./drizzle

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
REQUEST_ID_HEADER=x-request-id
LOG_LEVEL=info
ERROR_REDACTION_ENABLED=true
FEATURE_FLAGS_SOURCE=local
